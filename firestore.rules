rules_version = '2';

// FoundMe Firestore security rules.
// Goal: prevent users from escalating their own role/verification, prevent
// reading other users' private claims/messages, and prevent guests
// (anonymous auth) from posting items, claims, or chat messages.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // A real (non-guest) user.
    function isUser() {
      return isSignedIn() && !isAnonymous();
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function uidIs(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isClaimMember(claimId) {
      let claim = get(/databases/$(database)/documents/claims/$(claimId)).data;
      return uidIs(claim.ownerUid) || uidIs(claim.claimerUid);
    }

    // ----- users -----
    match /users/{uid} {
      // Public-ish profile (name, photoURL, role flag, ratings). Sensitive
      // identity data (matric number, card URL) lives in /verifications/{uid}
      // and is admin-readable only.
      allow read: if isSignedIn();

      // Self-create on first sign-in. Block role/disabled escalation. Allow
      // partial creates (e.g. saveUserToken merging only fcmToken+lastActive).
      allow create: if uidIs(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('disabled' in request.resource.data) || request.resource.data.disabled == false);

      // Self-update: allowlist exactly the fields a user may change about
      // their own profile. Everything else — role, disabled, isVerified,
      // matric*, AND averageRating/ratingCount (which only the submitReview
      // Cloud Function may write via the admin SDK) — is immutable from the
      // client. Using an affectedKeys allowlist (rather than per-field freezes)
      // means any field not listed here is rejected by default, so new
      // protected fields can't be silently forged.
      allow update: if isAdmin()
                    || (uidIs(uid)
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['name', 'photoURL', 'fcmTokens',
                                       'fcmToken', 'lastActive']));

      allow delete: if isAdmin();
    }

    // ----- items -----
    match /items/{itemId} {
      // Browsing: any signed-in user, including anonymous guests.
      allow read: if isSignedIn();

      // Posting: real users only (no guests). Owner must match caller and
      // initial status must be pending_approval (admins approve before active).
      allow create: if isUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending_approval';

      // Updates: owner can edit their own item but cannot self-approve.
      // ownerUid is immutable, status may only stay the same or move to a
      // terminal value (closed/resolved) — the owner can never flip an item to
      // 'active'. An affectedKeys allowlist limits owner writes to content
      // fields, the accept-lock (acceptedClaimId), and status, so they can't
      // inject arbitrary/privileged fields. Admins can update anything
      // (approve, reject, expire, etc).
      // NOTE: content fields remain editable post-approval; if bait-and-switch
      // moderation becomes a concern, force status back to 'pending_approval'
      // here whenever a content field changes.
      allow update: if isAdmin()
                    || (uidIs(resource.data.ownerUid)
                        && request.resource.data.ownerUid == resource.data.ownerUid
                        && (request.resource.data.status == resource.data.status
                            || request.resource.data.status in ['closed', 'resolved'])
                        && request.resource.data.diff(resource.data)
                             .affectedKeys()
                             .hasOnly(['type', 'title', 'desc', 'category',
                                       'tags', 'lat', 'lng', 'locationText',
                                       'updatedAt', 'status', 'acceptedClaimId']));

      allow delete: if uidIs(resource.data.ownerUid) || isAdmin();
    }

    // ----- claims -----
    match /claims/{claimId} {
      // Only the parties to a claim (or admin) can read it.
      allow read: if isSignedIn()
        && (uidIs(resource.data.ownerUid)
            || uidIs(resource.data.claimerUid)
            || isAdmin());

      // Create: real user, claiming someone else's item, status must start pending.
      allow create: if isUser()
        && request.resource.data.claimerUid == request.auth.uid
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'pending';

      // Update: parties can change status. Owner can accept/decline/close;
      // claimer can set 'closed', or re-open their own *declined* claim back to
      // 'pending' (re-claim). Status is whitelisted so an owner can't pin
      // arbitrary strings into the field. Review flags (which the submitReview
      // Cloud Function controls) and identity fields are immutable from client.
      allow update: if isSignedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.claimerUid == resource.data.claimerUid
        && request.resource.data.itemId == resource.data.itemId
        && request.resource.data.status in ['pending', 'accepted', 'declined', 'closed']
        && request.resource.data.get('ownerHasReviewed', false) == resource.data.get('ownerHasReviewed', false)
        && request.resource.data.get('claimerHasReviewed', false) == resource.data.get('claimerHasReviewed', false)
        && (uidIs(resource.data.ownerUid)
            || (uidIs(resource.data.claimerUid)
                && (request.resource.data.status == 'closed'
                    || (request.resource.data.status == 'pending'
                        && resource.data.status == 'declined'))));

      allow delete: if isAdmin();
    }

    // ----- messages (flat collection, keyed by claimId field) -----
    // Reads cost an extra get() to look up parent claim membership.
    match /messages/{messageId} {
      allow read: if isSignedIn()
        && (isClaimMember(resource.data.claimId) || isAdmin());

      allow create: if isUser()
        && request.resource.data.senderUid == request.auth.uid
        && isClaimMember(request.resource.data.claimId);

      // Chat is append-only.
      allow update, delete: if isAdmin();
    }

    // ----- reports -----
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isUser()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ----- logs -----
    match /logs/{logId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ----- verifications -----
    // Holds the sensitive matric data (number, name, signed card URL) that
    // used to live on the user doc. Only admins read it; only the
    // verifyMatricCard Cloud Function writes it (admin SDK bypasses rules).
    match /verifications/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
